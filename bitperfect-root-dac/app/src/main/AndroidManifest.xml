<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <!-- USB Host mode required for direct USB DAC exclusive takeover -->
    <uses-feature
        android:name="android.hardware.usb.host"
        android:required="true" />

    <!-- Localhost 127.0.0.1 TCP loopback bridge for LSPosed Apple Music AudioTrack direct PCM stream -->
    <uses-permission android:name="android.permission.INTERNET" />

    <!-- Pure Root / LSPosed + USB DAC Foreground Service (ZERO MediaProjection / RECORD_AUDIO!) -->
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_CONNECTED_DEVICE" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_MEDIA_PLAYBACK" />

    <!-- Foreground notification visibility on Android 13+ -->
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />

    <!-- Keep CPU awake & prevent OEM background freezer (e.g. HyperOS millet) from pausing audio -->
    <uses-permission android:name="android.permission.WAKE_LOCK" />
    <uses-permission android:name="android.permission.REQUEST_IGNORE_BATTERY_OPTIMIZATIONS" />

    <!-- Android 11+ package visibility to resolve Apple Music UID & quick-launch Apple Music -->
    <queries>
        <package android:name="com.apple.android.music" />
    </queries>

    <application
        android:name=".BitPerfectRootApp"
        android:allowBackup="false"
        android:icon="@mipmap/ic_launcher"
        android:roundIcon="@mipmap/ic_launcher_round"
        android:label="@string/app_name"
        android:supportsRtl="true"
        android:theme="@style/Theme.BitPerfectRootDac">

        <!-- LSPosed / Xposed API 82 Module Metadata -->
        <meta-data
            android:name="xposedmodule"
            android:value="true" />
        <meta-data
            android:name="xposeddescription"
            android:value="@string/xposed_description" />
        <meta-data
            android:name="xposedminversion"
            android:value="82" />
        <meta-data
            android:name="xposedscope"
            android:resource="@array/xposedscope" />

        <activity
            android:name=".MainActivity"
            android:exported="true"
            android:launchMode="singleTop">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>

            <!-- Optional USB Audio device attach filter -->
            <intent-filter>
                <action android:name="android.hardware.usb.action.USB_DEVICE_ATTACHED" />
            </intent-filter>
            <meta-data
                android:name="android.hardware.usb.action.USB_DEVICE_ATTACHED"
                android:resource="@xml/usb_device_filter" />
        </activity>

        <!-- Pure USB DAC + MediaPlayback Foreground Service (zero MediaProjection) -->
        <service
            android:name=".service.RootDacService"
            android:enabled="true"
            android:exported="false"
            android:stopWithTask="false"
            android:foregroundServiceType="connectedDevice|mediaPlayback" />

    </application>
</manifest>
